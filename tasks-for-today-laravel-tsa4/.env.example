APP_NAME="Tasks for Today"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Default: SQLite (zero-config local setup — create database/database.sqlite)
DB_CONNECTION=sqlite
# For MySQL / MariaDB (e.g., XAMPP or Laragon), uncomment and update below:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tasks_for_today_tsa4
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Mail configuration (uses Laravel's log driver by default so emails can be verified in storage/logs/laravel.log)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@tasksfortoday.local"
MAIL_FROM_NAME="${APP_NAME}"

# Recipient address notified automatically whenever a task's status changes to "done"
TASK_NOTIFICATION_RECIPIENT="jpenarroyo53@gmail.com"
